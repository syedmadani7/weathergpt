# Keep real secrets in backend/.env only. Never commit this file with real keys.
OPENWEATHER_API_KEY=your_openweathermap_key
GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-20b
DATABASE_URL=postgresql+psycopg://weathergpt:weathergpt@db:5432/weathergpt
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,ta,te,bn,mr,gu,kn,ml,pa,or
WEATHER_CACHE_TTL=300
LLM_CACHE_TTL=900
ALERT_POLL_SECONDS=60
ALERT_TEMPERATURE_C=45
ALERT_RAINFALL_MM=100
